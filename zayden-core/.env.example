# ─────────────────────────────────────────────────────────────────────────────
# Zayden Protocol v3.0 — Backend environment variables
# Copy this file to .env and fill in your real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq LLM (required) ──────────────────────────────────────────────────────
# Comma-separated if you have multiple keys for failover/rotation.
GROQ_API_KEYS=gsk_your_key_here,gsk_optional_second_key

# Optional Groq tuning
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=2048
GROQ_TIMEOUT_S=12
GROQ_TOTAL_BUDGET_S=14
GROQ_DEFAULT_COOLDOWN_S=60

# ── ElevenLabs TTS (required for audio) ─────────────────────────────────────
# Get your API key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Find voice IDs at: https://elevenlabs.io/voice-library
# Or via API: GET https://api.elevenlabs.io/v1/voices
ELEVENLABS_VOICE_ID=your_voice_id_here

# Optional ElevenLabs tuning
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.80
ELEVENLABS_STYLE=0.35
ELEVENLABS_SPEAKER_BOOST=true

# ── Local code execution ─────────────────────────────────────────────────────
# WARNING: Setting this to true allows the backend to run arbitrary Python code
# sent by any client that can reach the API. Only enable on a trusted local
# machine with no public network exposure.
ZAYDEN_ALLOW_CODE_EXEC=false
ZAYDEN_CODE_EXEC_TIMEOUT_S=10

# ── CORS ─────────────────────────────────────────────────────────────────────
ZAYDEN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
